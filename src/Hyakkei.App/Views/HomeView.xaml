<UserControl x:Class="Hyakkei.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="MinWidth" Value="200" />
        </Style>
        <Style x:Key="CardGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="百景工具箱" FontSize="30" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="你的个人功能中心 —— 所有小工具，一个入口。"
                       FontSize="14" Margin="0,6,0,24"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <WrapPanel>
                <Border Style="{StaticResource InfoCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE765;" />
                        <TextBlock Style="{StaticResource CardTitle}" Text="唤起岛" />
                        <TextBlock Style="{StaticResource CardValue}" Text="双击 Ctrl" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource InfoCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE946;" />
                        <TextBlock Style="{StaticResource CardTitle}" Text="岛内操作" />
                        <TextBlock Style="{StaticResource CardValue}" Text="数字直达 · Esc 返回" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource InfoCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE71D;" />
                        <TextBlock Style="{StaticResource CardTitle}" Text="已装载工具模块" />
                        <TextBlock x:Name="ToolCountText" Style="{StaticResource CardValue}" Text="0 个" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock Text="日常使用走岛：双击 Ctrl 唤起，点图标或按数字键进入功能，失焦自动收起。此窗口用于模块开关与详细设置，托盘右键可再次打开；退出程序也在托盘右键菜单。"
                       TextWrapping="Wrap"
                       FontSize="13" Margin="0,12,0,0"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
