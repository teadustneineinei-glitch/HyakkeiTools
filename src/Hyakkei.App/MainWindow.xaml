<ui:FluentWindow x:Class="Hyakkei.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:Hyakkei.App"
                 Title="百景工具箱"
                 Width="980" Height="620"
                 MinWidth="720" MinHeight="480"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Icon="pack://application:,,,/Assets/logo.png"
                 PreviewKeyDown="OnWindowPreviewKeyDown">

    <ui:FluentWindow.Resources>
        <!-- 侧栏导航项：圆角、悬停淡入、选中带主题色指示条 -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" CornerRadius="6" Margin="0,2" Padding="12,9" Background="Transparent">
                            <Grid>
                                <Rectangle x:Name="Pill" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5"
                                           HorizontalAlignment="Left" Margin="-8,0,0,0"
                                           Fill="{DynamicResource AccentTextFillColorPrimaryBrush}" Opacity="0" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                <Setter TargetName="Pill" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type local:NavEntry}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="16"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="百景工具箱" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏 -->
            <Grid Grid.Column="0" Margin="12,4,4,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox x:Name="NavList" Grid.Row="0"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         ItemTemplate="{StaticResource NavItemTemplate}"
                         SelectionChanged="OnNavSelectionChanged" />

                <ListBox x:Name="FooterList" Grid.Row="1"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         ItemTemplate="{StaticResource NavItemTemplate}"
                         SelectionChanged="OnFooterSelectionChanged" />
            </Grid>

            <!-- 右侧内容区：分层背景 + 圆角 -->
            <Border Grid.Column="1" Margin="4,4,12,12" CornerRadius="8"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <ContentControl x:Name="ToolHost" />
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
