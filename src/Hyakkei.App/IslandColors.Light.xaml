<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 岛配色 · 天青（浅色）：宣纸白底 + 青灰蓝强调，设计稿见 docs/design/island-colors (E · 天青) -->
    <SolidColorBrush x:Key="Island.Bg" Color="#F0FAFCFC" />
    <SolidColorBrush x:Key="Island.TextPrimary" Color="#FF363B3A" />
    <SolidColorBrush x:Key="Island.TextSecondary" Color="#FF9AA19C" />
    <SolidColorBrush x:Key="Island.TextTertiary" Color="#FFABB1AB" />
    <SolidColorBrush x:Key="Island.IconDefault" Color="#FF8A8F8A" />
    <SolidColorBrush x:Key="Island.Hairline" Color="#123C3C3C" />
    <SolidColorBrush x:Key="Island.HoverWash" Color="#0A3C4646" />
    <SolidColorBrush x:Key="Island.TrackWash" Color="#0C3C4646" />
    <SolidColorBrush x:Key="Island.SegmentOn" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Island.SegmentOnBorder" Color="#143C4646" />
    <SolidColorBrush x:Key="Island.Accent" Color="#FF6E99A1" />
    <SolidColorBrush x:Key="Island.AccentWash" Color="#146E99A1" />
    <SolidColorBrush x:Key="Island.AccentBorder" Color="#4D6E99A1" />

</ResourceDictionary>
