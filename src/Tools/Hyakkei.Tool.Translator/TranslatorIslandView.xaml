<UserControl x:Class="Hyakkei.Tool.Translator.TranslatorIslandView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hyakkei.Tool.Translator">

    <!-- 布局遵循 docs/design/DESIGN.md：输入 → 译文 → 底行（目标语言 + 主按钮 + 键位） -->
    <StackPanel>
        <Border CornerRadius="6" BorderThickness="1" Padding="12,8"
                BorderBrush="{DynamicResource Island.Hairline}">
            <TextBox x:Name="InputBox" Style="{x:Null}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     FontSize="14" TextWrapping="Wrap" AcceptsReturn="False"
                     MaxHeight="64" VerticalScrollBarVisibility="Auto"
                     Foreground="{DynamicResource Island.TextPrimary}"
                     CaretBrush="{DynamicResource Island.Accent}"
                     TextChanged="OnInputChanged" KeyDown="OnInputKeyDown" />
        </Border>

        <Border x:Name="ResultPanel" CornerRadius="6" Padding="12,8" Margin="0,8,0,0"
                Background="{DynamicResource Island.TrackWash}" Visibility="Collapsed">
            <local:SelectableText x:Name="ResultBox" FontSize="14" LineHeight="22" MaxHeight="140"
                                  Foreground="{DynamicResource Island.TextPrimary}" />
        </Border>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="6" Padding="2" Background="{DynamicResource Island.TrackWash}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="AutoBtn" GroupName="tgt" Content="自动"
                                 Style="{DynamicResource Island.Segment}" Checked="OnTargetChanged" />
                    <RadioButton x:Name="ZhBtn" GroupName="tgt" Content="中"
                                 Style="{DynamicResource Island.Segment}" Checked="OnTargetChanged" />
                    <RadioButton x:Name="EnBtn" GroupName="tgt" Content="EN"
                                 Style="{DynamicResource Island.Segment}" Checked="OnTargetChanged" />
                    <RadioButton x:Name="FrBtn" GroupName="tgt" Content="FR"
                                 Style="{DynamicResource Island.Segment}" Checked="OnTargetChanged" />
                </StackPanel>
            </Border>

            <Button x:Name="SnipBtn" Grid.Column="2" Content="截屏" Margin="0,0,8,0"
                    Style="{DynamicResource Island.Button}" Click="OnSnipClick" />
            <Button x:Name="CopyBtn" Grid.Column="3" Content="复制"
                    Style="{DynamicResource Island.PrimaryButton}" Click="OnCopyClick" />
            <TextBlock x:Name="HotkeyHint" Grid.Column="4" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Island.TextTertiary}" />
        </Grid>
    </StackPanel>
</UserControl>
